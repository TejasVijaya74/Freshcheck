{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "/tmp/config.db" }
  },
  "logs_store": { "enabled": false },
  "providers": {
    "groq": {
      "keys": [{ "value": "env.GROQ_API_KEY", "models": [], "weight": 1.0 }]
    }
  }
}